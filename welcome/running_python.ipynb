        "motivo": "Puede donar solo a AB, pero puede recibir de tipos negativos sin provocar reacciones."
    },
    "AB+": {
        "puede_donar_a": ["AB+"],
        "puede_recibir_de": ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"],
        "descripcion": "Tipo AB positivo. Tiene antígenos A, B y Rh. No tiene anticuerpos.",
        "motivo": "Receptor universal, porque acepta todos los tipos sin generar rechazo."
    },
}

def mostrar_info(tipo_sangre):
    tipo_sangre = tipo_sangre.upper()
    if tipo_sangre in info_sangre:
        datos = info_sangre[tipo_sangre]
        print(f"\n🧪 Tipo de sangre: {tipo_sangre}")
        print(f"🩸 Puede donar a: {', '.join(datos['puede_donar_a'])}")
        print(f"❤️ Puede recibir de: {', '.join(datos['puede_recibir_de'])}")
        print(f"📘 Información: {datos['descripcion']}")
        print(f"🔍 Motivo de compatibilidad: {datos['motivo']}")
    else:
        print("❌ Tipo de sangre no reconocido. Intenta con: O-, O+, A-, A+, B-, B+, AB-, AB+")

# Ejecución del programa
tipo = input("Ingresa tu tipo de sangre (ej. O-, A+, AB+): ")
mostrar_info(tipo)
