# Diccionario con información completa
info_sangre = {
    "O-": {
        "puede_donar_a": ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"],
        "puede_recibir_de": ["O-"],
        "descripcion": "Tipo O negativo. No tiene antígenos A ni B, ni factor Rh. Tiene anticuerpos anti-A y anti-B.",
        "motivo": "Puede donar a todos porque su sangre no presenta antígenos que provoquen reacción en otros tipos."
    },
    "O+": {
        "puede_donar_a": ["O+", "A+", "B+", "AB+"],
        "puede_recibir_de": ["O-", "O+"],
        "descripcion": "Tipo O positivo. No tiene antígenos A ni B, pero sí tiene factor Rh. Tiene anticuerpos anti-A y anti-B.",
        "motivo": "Puede donar a tipos positivos porque tiene el antígeno Rh, pero no A ni B."
    },
    "A-": {
        "puede_donar_a": ["A-", "A+", "AB-", "AB+"],
        "puede_recibir_de": ["O-", "A-"],
        "descripcion": "Tipo A negativo. Tiene antígeno A, no tiene Rh. Tiene anticuerpos anti-B.",
        "motivo": "Puede donar a personas con antígeno A y sin Rh o que sean Rh+, ya que no tiene Rh."
    },
    "A+": {
        "puede_donar_a": ["A+", "AB+"],
        "puede_recibir_de": ["O-", "O+", "A-", "A+"],
        "descripcion": "Tipo A positivo. Tiene antígeno A y Rh. Tiene anticuerpos anti-B.",
        "motivo": "Solo puede donar a otros con antígeno A y Rh+ para evitar reacciones."
    },
    "B-": {
        "puede_donar_a": ["B-", "B+", "AB-", "AB+"],
        "puede_recibir_de": ["O-", "B-"],
        "descripcion": "Tipo B negativo. Tiene antígeno B, no Rh. Tiene anticuerpos anti-A.",
        "motivo": "Puede donar a quienes tienen antígeno B y carecen o toleran Rh."
    },
    "B+": {
        "puede_donar_a": ["B+", "AB+"],
        "puede_recibir_de": ["O-", "O+", "B-", "B+"],
        "descripcion": "Tipo B positivo. Tiene antígeno B y Rh. Tiene anticuerpos anti-A.",
        "motivo": "Compatible con otros con antígeno B y Rh+."
    },
    "AB-": {
        "puede_donar_a": ["AB-", "AB+"],
        "puede_recibir_de": ["O-", "A-", "B-", "AB-"],
